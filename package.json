{
  "name": "liquidframe",
  "version": "0.1.0",
  "description": "Pure-CSS iPhone 16 Pro mockup with realistic iOS 26 Liquid Glass Safari chrome (Compact / Bottom / Top / PWA). Zero dependencies — one stylesheet and some HTML.",
  "type": "module",
  "main": "liquidframe.js",
  "style": "liquidframe.css",
  "exports": {
    ".": "./liquidframe.js",
    "./css": "./liquidframe.css"
