    "liquidframe.css",
    "liquidframe.js",
    "index.html",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "ios",
    "iphone",
    "safari",
    "ios26",
    "liquid-glass",
    "mockup",
    "device-frame",
    "simulator",
    "css",
    "zero-config"
  ],
  "license": "MIT",
  "sideEffects": [
    "liquidframe.js",
    "*.css"
  ]
